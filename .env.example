# ==============================================================================
# GridRetail — Phase 2 Environment Configuration Template
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Connection URI (Optional in dev/test - graceful in-memory fallback enabled)
MONGODB_URI=mongodb://localhost:27017/gridretail

# Auth.js / NextAuth v5 Secret Key (generate via: openssl rand -base64 32)
AUTH_SECRET=gridretail_super_secure_phase2_secret_key_change_in_production_32chars!

# Initial Admin Bootstrap Credentials (Used by: npm run bootstrap-admin)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@gridretail.internal
ADMIN_PASSWORD=AdminGrid2026!
