# ==============================================================================
# GridRetail — Phase 3 Environment Configuration Template
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Connection URI (Optional in dev/test - graceful in-memory fallback enabled)
MONGODB_URI=mongodb://localhost:27017/gridretail

# Auth.js / NextAuth v5 Secret Key (generate via: openssl rand -base64 32)
AUTH_SECRET=gridretail_super_secure_secret_key_change_in_production_32chars!

# Initial Admin Bootstrap Credentials (Used by: npm run bootstrap-admin)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@gridretail.internal
ADMIN_PASSWORD=AdminGrid2026!

# Cloud Object Storage (S3 / R2 compatible) — Optional; falls back to /public/uploads
S3_BUCKET_NAME=gridretail-media
S3_ENDPOINT=https://gridretail-media.s3.amazonaws.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
