# ==============================================================================
# GridRetail — Phase 7 Production Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - Use safe placeholders; NEVER commit real credentials to version control.
# - In production, replace localhost URLs with your fully-qualified domain.
# - Server-only secrets MUST NOT be prefixed with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application URLs (REQUIRED)
# For local development: http://localhost:3000
# For production staging: https://gridretail.yourdomain.com
# ------------------------------------------------------------------------------
NEXTAUTH_URL=https://gridretail.yourdomain.com
NEXT_PUBLIC_APP_URL=https://gridretail.yourdomain.com

# Node Environment: "production" | "development" | "test"
# WARNING: When NODE_ENV=production, silent in-memory fallback is strictly blocked.
NODE_ENV=production

# Security Flag (REQUIRED: Set to "false" in production to disable UI demo login shortcuts)
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# ------------------------------------------------------------------------------
# 2. Database Foundation — MongoDB Atlas (REQUIRED IN PRODUCTION)
# In dev/test: omission defaults transparently to local in-memory fallback.
# In production: MONGODB_URI is strictly required. Writes will fail safely if unreachable.
# After configuring MONGODB_URI, run index synchronization: npm run sync-indexes
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_address>.mongodb.net/<db_name>?retryWrites=true&w=majority
MONGODB_DB_NAME=gridretail

# ------------------------------------------------------------------------------
# 3. Authentication & Session Security — Auth.js / NextAuth v5 (REQUIRED)
# Generate a unique 32+ character key using: openssl rand -base64 32
# ------------------------------------------------------------------------------
AUTH_SECRET=<generate_with_openssl_rand_base64_32>

# Initial Admin Bootstrap Credentials (Used only by: npm run bootstrap-admin)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@gridretail.internal
ADMIN_PASSWORD=<Rudra@123456>

# ------------------------------------------------------------------------------
# 4. Durable Cloud Media Storage & Retention — AWS S3 / Cloudflare R2 (OPTIONAL IN DEV, REQUIRED FOR DURABLE PRODUCTION)
# If unconfigured: defaults safely to local disk uploads.
# Enforces private bucket policy and authentic AWS SigV4 signed URL generation.
# ------------------------------------------------------------------------------
S3_BUCKET_NAME=<your_s3_bucket_name>
S3_ENDPOINT=https://<your_s3_bucket_name>.s3.<your_aws_region>.amazonaws.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<your_aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<your_aws_secret_access_key>
S3_PUBLIC_READ=false
ARTIFACT_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 5. Transactional Email Notifications — SMTP Relay (OPTIONAL)
# If unconfigured: defaults safely to ConsoleMockEmailProvider with in-memory outbox.
# ------------------------------------------------------------------------------
SMTP_HOST=<your_smtp_relay_host_e.g._smtp.sendgrid.net>
SMTP_PORT=587
SMTP_USER=<your_smtp_username_or_api_key>
SMTP_PASSWORD=<your_smtp_password_or_token>
SMTP_FROM=notifications@gridretail.internal
NOTIFICATION_SENDER_EMAIL=notifications@gridretail.internal

# ------------------------------------------------------------------------------
# 6. Cloud Staging Deployment Integrations (OPTIONAL)
# If unconfigured: defaults safely to simulated edge network preview URLs.
# ------------------------------------------------------------------------------
# Cloudflare Pages Adapter:
CLOUDFLARE_API_TOKEN=<your_cloudflare_api_token>
CLOUDFLARE_ACCOUNT_ID=<your_cloudflare_account_id>

# Vercel Adapter:
VERCEL_TOKEN=<your_vercel_token>
VERCEL_PROJECT_ID=<your_vercel_project_id>

# AWS S3 Static Website Hosting Adapter:
AWS_S3_BUCKET=<your_s3_static_website_bucket_name>

# ------------------------------------------------------------------------------
# 7. Local Store Subdomain Routing Configuration (PHASE 8)
# Controls store-name-based local hostname resolution and URL generation.
# In local dev: http://{slug}.localhost:3000
# Modern browsers automatically resolve *.localhost loopback addresses (RFC 6761).
# In production: default mode is "path" (https://yourdomain.com/store/{slug}).
# ------------------------------------------------------------------------------
GRIDRETAIL_LOCAL_HOST_SUFFIX=localhost
GRIDRETAIL_LOCAL_PORT=3000
GRIDRETAIL_STORE_URL_MODE=subdomain
